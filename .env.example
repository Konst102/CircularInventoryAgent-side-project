# Circular Inventory Agent — Environment Variables

# Required: DashScope / BaiLian API key
# Get yours at: https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: Client API key for webhook authentication
WEBHOOK_API_KEY=sk-test-12345

# Optional: Server bind address
HOST=0.0.0.0
PORT=8000
